{
  "name": "agro-ai",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:baseline": "npx tsx scripts/baseline-drizzle-migrations.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "npx tsx scripts/seed-parcels.ts",
    "db:seed:trace": "npx tsx scripts/seed-trace-lots.ts",
    "db:seed:review": "npx tsx scripts/seed-review-decisions.ts",
    "smoke:trace-eudr": "npx tsx scripts/smoke-trace-eudr.ts",
    "smoke:trace": "npx tsx scripts/smoke-trace.ts",
    "smoke:review": "npx tsx scripts/smoke-review.ts",
    "smoke:parcels": "npx tsx scripts/smoke-parcels.ts",
    "smoke:weather": "npx tsx scripts/smoke-weather.ts",
    "smoke:spectral": "npx tsx scripts/smoke-spectral.ts",
    "smoke:spectral-backfill-ica": "npx tsx scripts/smoke-spectral-backfill-ica.ts",
    "smoke:spectral-perf": "npx tsx scripts/smoke-spectral-perf.ts",
    "smoke:report-contrast": "npx tsx scripts/smoke-report-contrast.ts",
    "tally:report-suggestion-labels": "npx tsx scripts/tally-report-suggestion-labels.ts",
    "smoke:agent": "npx tsx scripts/smoke-agent.ts",
    "smoke:admin": "npx tsx scripts/smoke-admin.ts",
    "smoke:all": "npx tsx scripts/smoke-all.ts",
    "audit:env": "npx tsx scripts/audit-environments.ts",
    "qa:regression": "npm test && npm run lint && SMOKE_SENAMHI=1 SMOKE_SENTINEL_STUB=1 npm run smoke:all",
    "db:cleanup:lima-smoke": "npx tsx scripts/cleanup-lima-coffee-smoke.ts",
    "db:cleanup:review-smoke": "npx tsx scripts/cleanup-review-smoke.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.86",
    "@clerk/nextjs": "^7.0.0",
    "@neondatabase/serverless": "^1.1.0",
    "@sparticuz/chromium": "^149.0.0",
    "ai": "^6.0.0",
    "drizzle-orm": "^0.45.2",
    "geotiff": "^3.0.5",
    "maplibre-gl": "^6.6.0",
    "next": "^16.3.3",
    "puppeteer-core": "^25.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "terra-draw": "^1.32.3",
    "terra-draw-maplibre-gl-adapter": "^1.4.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.0.0"
  }
}
