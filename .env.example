# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Canonical origin for org invitation redirects (stg: https://stg.geoagro.ai, prod: https://geoagro.ai)
NEXT_PUBLIC_APP_URL=
# Svix signing secret from Clerk Dashboard → Webhooks (Billing sync; distinct per stg vs Production)
CLERK_WEBHOOK_SIGNING_SECRET=

# Neon Postgres (Vercel Marketplace)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Optional: for Neon CLI / local MCP helpers (never commit real values)
NEON_API_KEY=

# Weather source for runtime: offline | free | open-meteo | nasa-power | senamhi_stub
# senamhi (live) is rejected until contract/legal — use senamhi_stub (requires weather_plus)
WEATHER_SOURCE=offline

# Spectral / vegetation indices: offline | sentinel_hub_stub | sentinel_hub (CDSE live)
SPECTRAL_SOURCE=offline
# CDSE OAuth client (Dashboard → User settings → OAuth clients). Never commit real values.
# SENTINEL_CLIENT_ID=
# SENTINEL_CLIENT_SECRET=
# Optional overrides:
# CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
# CDSE_STATISTICS_URL=https://sh.dataspace.copernicus.eu/api/v1/statistics
# SPECTRAL_LOOKBACK_DAYS=30
# SPECTRAL_FRESHNESS_DAYS=14
# SPECTRAL_MAX_CLOUD_COVERAGE=80
# SPECTRAL_CACHE_TTL_MS=3600000
# Spectral scene cron (Plus; ver docs/spectral/discovery.md Spectral-8):
# CRON_SECRET=
# SPECTRAL_CRON_ORG_IDS=org_xxx
# SPECTRAL_CRON_MAX_PARCELS=25
# SPECTRAL_BACKFILL_MAX_DAYS=90

# Clerk org publicMetadata (Dashboard / Backend API):
# entitlements: ["weather"]
# authorizedParcelIds: []  → all org parcels (ADR-011); non-empty = allowlist

# Agro Agent (Plus + LLM via Vercel AI Gateway — ADR-015)
# On Vercel Production, OIDC auth is automatic (no provider key).
# Local: `vercel env pull` (VERCEL_OIDC_TOKEN) or set AI_GATEWAY_API_KEY.
AI_GATEWAY_MODEL=openai/gpt-4o-mini
# AI_GATEWAY_API_KEY=

# Reports PDF: stub (tests) | local Chrome auto-detected in dev | @sparticuz/chromium on Vercel
# REPORT_PDF_MODE=stub
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
