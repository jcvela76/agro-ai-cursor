# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Neon Postgres (Vercel Marketplace)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# Optional: for Neon CLI / local MCP helpers (never commit real values)
NEON_API_KEY=

# Weather source for runtime: offline | free | open-meteo | nasa-power
WEATHER_SOURCE=offline

# Clerk org publicMetadata (Dashboard / Backend API):
# entitlements: ["weather"]
# authorizedParcelIds: []  → all org parcels (ADR-011); non-empty = allowlist

# Agro Agent (Plus + LLM via Vercel AI Gateway — ADR-015)
# On Vercel Production, OIDC auth is automatic (no provider key).
# Local: `vercel env pull` (VERCEL_OIDC_TOKEN) or set AI_GATEWAY_API_KEY.
AI_GATEWAY_MODEL=openai/gpt-4o-mini
# AI_GATEWAY_API_KEY=
